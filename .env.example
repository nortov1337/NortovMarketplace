# Public application URL. HTTPS is required in production.
APP_URL=http://localhost:3000
# Set to false only for local HTTP; use true for HTTPS.
COOKIE_SECURE=false
# Enable only behind a trusted reverse proxy.
TRUST_PROXY=false
# Configure SMTP_URL and MAIL_FROM for email. Keep credentials outside the repository.
SMTP_URL=
MAIL_FROM=
# Require email verification at registration (requires SMTP and APP_URL).
REQUIRE_EMAIL_VERIFICATION=false
