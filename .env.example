# Внешний адрес приложения. В production обязателен HTTPS.
APP_URL=http://localhost:3000
# Только для локального HTTP. Для HTTPS установите true.
COOKIE_SECURE=false
# Установите true только за настроенным доверенным reverse proxy.
TRUST_PROXY=false
# Для писем заполните SMTP_URL и MAIL_FROM; храните пароль SMTP вне репозитория.
SMTP_URL=
MAIL_FROM=
# Требовать подтверждение email при регистрации (нужны SMTP и APP_URL).
REQUIRE_EMAIL_VERIFICATION=false
